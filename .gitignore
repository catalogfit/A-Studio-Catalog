# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.pem
*.key
client_secret*.json
service-account*.json

# ---- OAuth sessions / refresh tokens ----
.data/
**/.data/

# ---- dependencies & build noise ----
node_modules/
npm-debug.log*
yarn-error.log*

# ---- macOS ----
.DS_Store
.AppleDouble
# Finder's custom-icon file is literally "Icon\r". Written as `Icon?` it also matched
# the directory `backend/icons` on this case-insensitive filesystem, silently excluding
# the whole icon backup from the repo.
Icon[$'\r']

# ---- editors ----
.vscode/
.idea/
*.swp

# ---- scratch ----
tmp/
*.tmp
~$*.xlsx
